# ---- Backend ----
# Local default is SQLite (no setup). For Supabase/Render use the pooled Postgres URL, e.g.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Protects /api/v1/admin/* (ingestion). Required in any deployed environment.
ADMIN_TOKEN=
# Shared single-workspace write key (24+ chars). Required when APP_ENV=production. Never put it in NEXT_PUBLIC_*.
WORKSPACE_WRITE_TOKEN=
CORS_ORIGINS=http://localhost:3000
# Opening the backend URL in a browser redirects here (your Vercel URL in production). API docs: <backend>/docs
FRONTEND_URL=http://localhost:3000

# Optional LLM (any OpenAI-compatible endpoint with tool calling). Leave LLM_API_KEY empty for deterministic mode.
# OpenAI:  LLM_BASE_URL empty, LLM_MODEL_FAST=gpt-4o-mini, LLM_MODEL_REASONING=gpt-4.1
# Groq (free tier): LLM_BASE_URL=https://api.groq.com/openai/v1, both models llama-3.3-70b-versatile
#                   (Groq has no embeddings endpoint -> retrieval stays BM25; set # Optional fallback chains (comma-separated), tried when a model is rate-limited/overloaded/retired, e.g. for Gemini:
# LLM_FALLBACK_MODELS_REASONING=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
LLM_FALLBACK_MODELS_REASONING=
LLM_FALLBACK_MODELS_FAST=
LLM_EMBEDDING_MODEL= empty)
# Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/,
#                   LLM_MODEL_FAST=gemini-flash-lite-latest, LLM_MODEL_REASONING=gemini-3.5-flash,
#                   LLM_EMBEDDING_MODEL=gemini-embedding-001  (verified 15 Nov 2026; gemini-2.5-flash returned 404)
LLM_API_KEY=AQ.Ab8RN6I55hNsWPVupGq7Y5ofXgI6iVdVuTiQuOy_9LB3XLINAA
LLM_BASE_URL=curl "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent" \
  -H 'Content-Type: application/json' \
  -H 'X-goog-api-key: AQ.Ab8RN6I55hNsWPVupGq7Y5ofXgI6iVdVuTiQuOy_9LB3XLINAA' \
  -X POST \
  -d '{
    "contents": [
      {
        "parts": [
          {
            "text": "Explain how AI works in a few words"
          }
        ]
      }
    ]
  }'
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_REASONING=gpt-4.1
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_CALLS_PER_RUN=40

# Daily refresh (prices, filings, analysis, new filing/transcript/annual-report text for Research, alerts).
# Runs in-process at these IST times plus a catch-up on startup; set SCHEDULER_ENABLED=false if an external cron
# (e.g. .github/workflows/daily-ingest.yml) drives ingestion instead.
SCHEDULER_ENABLED=true
# Durable document-ingestion worker (retries with backoff, recovers jobs interrupted by a restart). Extra workers can run
# as separate processes: `python -m app.cli worker`; a database lease stops two workers taking the same job.
JOBS_WORKER_ENABLED=true
DAILY_REFRESH_TIMES_IST=08:30,18:30
DAILY_MAX_NEW_DOCUMENTS=60

# ---- Frontend ----
# Web app (server-side only): the browser calls /api/finn, which forwards here and adds the workspace key for writes.
FINN_API_URL=http://localhost:8000
FINN_WORKSPACE_KEY=
# Optional password for a public demo (HTTP basic auth on every page). Everyone who knows it shares one workspace.
FINN_SITE_PASSWORD=
# Optional, development only: browser talks to the API directly (writes then only work from localhost).
# NEXT_PUBLIC_API_URL=http://localhost:8000
